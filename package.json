{
  "name": "markeasy",
  "productName": "MarkEasy",
  "version": "1.0.0",
  "description": "本地 Markdown 编辑与预览桌面应用（macOS / Windows）",
  "main": "src/main/main.js",
  "author": "gongminghua",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/run-electron.js",
    "dev": "node scripts/run-electron.js --dev",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node scripts/unit-test.js",
    "test:e2e": "node scripts/run-electron.js --test=scripts/e2e-test.js",
    "screenshots": "node scripts/run-electron.js --test=scripts/screenshot.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "dist:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "com.markeasy.app",
    "productName": "MarkEasy",
    "afterPack": "./scripts/after-pack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MarkEasy",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "codemirror": "^5.65.21",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  }
}
